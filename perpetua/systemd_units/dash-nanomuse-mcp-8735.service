[Unit]
Description=Dash nanoMuse MCP server (127.0.0.1:8735)
After=network.target

[Service]
Environment=HOME=/home/hatch
Environment=http_proxy=http://198.19.0.1:3128
Environment=https_proxy=http://198.19.0.1:3128
Environment=HTTP_PROXY=http://198.19.0.1:3128
Environment=HTTPS_PROXY=http://198.19.0.1:3128
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/nanomuse-mcp
ExecStart=/bin/bash -c 'exec /home/hatch/data/mcp_server/venv/bin/python server.py >> /tmp/nanomuse-mcp.log 2>&1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
