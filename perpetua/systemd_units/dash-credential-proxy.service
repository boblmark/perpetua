[Unit]
Description=Dash credential proxy (C2: vault-backed token broker, SO_PEERCRED)
After=network.target

[Service]
Environment=HOME=/home/hatch
Environment=http_proxy=http://198.19.0.1:3128
Environment=https_proxy=http://198.19.0.1:3128
Environment=HTTP_PROXY=http://198.19.0.1:3128
Environment=HTTPS_PROXY=http://198.19.0.1:3128
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Type=simple
ExecStart=/usr/bin/python3 /home/hatch/data/perpetua/credential_proxy_server.py
Restart=always
RestartSec=5
RuntimeDirectory=credential-proxy
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
