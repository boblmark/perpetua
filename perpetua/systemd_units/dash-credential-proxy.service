[Unit]
Description=Dash credential proxy (C2: vault-backed token broker, SO_PEERCRED)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/hatch/data/perpetua/credential_proxy_server.py
Restart=always
RestartSec=5
RuntimeDirectory=credential-proxy
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
