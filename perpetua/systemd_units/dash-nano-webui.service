[Unit]
Description=Dash nano web UI static server (127.0.0.1:18737)
After=network.target

[Service]
Environment=HOME=/home/hatch
Environment=http_proxy=http://198.19.0.1:3128
Environment=https_proxy=http://198.19.0.1:3128
Environment=HTTP_PROXY=http://198.19.0.1:3128
Environment=HTTPS_PROXY=http://198.19.0.1:3128
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Type=simple
User=root
WorkingDirectory=/home/hatch/data/nanomuse-migration/perception/web
ExecStart=/bin/bash -c 'exec python3 -m http.server 18737 --bind 127.0.0.1 >> /tmp/nano-webui-18737.log 2>&1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
