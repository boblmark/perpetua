[Unit]
Description=Semantica Knowledge Graph 18091 Tunnel
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash /home/hatch/data/perpetua/vps_console/tunnel_18091.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/hatch/data/perpetua/vps_console/tunnel_18091.log
StandardError=append:/home/hatch/data/perpetua/vps_console/tunnel_18091.log

[Install]
WantedBy=multi-user.target
